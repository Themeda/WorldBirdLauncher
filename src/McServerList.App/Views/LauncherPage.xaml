<UserControl x:Class="McServerList.App.Views.LauncherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:McServerList.App.Views"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <UserControl.Resources>
        <!-- 热门榜玩法标签页：与整体风格一致的扁平样式（选中项用主题色下划线） -->
        <Style x:Key="HotTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="10,5" Margin="0,0,4,0"
                                Background="Transparent" CornerRadius="6,6,0,0"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 只显示标签头、不带内容区的 TabControl 模板 -->
        <Style x:Key="HotTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource HotTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True" Background="Transparent" HorizontalAlignment="Left" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= 启动区 ================= -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 不用 ScrollViewer：否则 Star 行会被无限高度压扁，头像就不会随窗口高度移动 -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="12" />
                                <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="账户" FontSize="11" Margin="0,0,0,4"
                                   Grid.Row="0"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <Grid Grid.Row="0" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AccountBox" Height="32" SelectionChanged="OnAccountTypeSelected" />
                            <Button x:Name="SwitchAccountButton" Grid.Column="1" Content="切换账号" Height="32"
                                    Margin="8,0,0,0" Padding="12,0"
                                    Style="{StaticResource GhostButton}" Click="OnSwitchAccount" />
                        </Grid>

                        <!-- 头像放大并居中，用户名/账户类型放在头像下方；
                             上下用 Star 行撑开，窗口高度变化时头像位置跟着动 -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                            <Border Width="104" Height="104" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="AvatarText" Text="?" FontSize="42" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="AvatarImage" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="UserNameText" Text="未登录" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,10,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="UserTypeText" Text="选择账户类型后登录" FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>

                            <StackPanel Grid.Row="4" Margin="0,16,0,0">
                                <TextBlock x:Name="LaunchSummaryText" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="版本、Java、内存与服务器地址可在「设置」里配置" />
                                <TextBlock x:Name="ServerHintText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentHoverBrush}" />
                            </StackPanel>
                    </Grid>

                    <!-- 启动按钮固定在卡片底部 -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Button x:Name="LaunchButton" Content="启动游戏" Height="56" FontSize="19"
                                Style="{StaticResource PrimaryButton}" Click="OnLaunch" />
                        <!-- 进度条留在按钮下方；提示/进度**文字**按用户要求放到程序最底部提示行（MainWindow.LauncherHintBar） -->
                        <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="ProgressText" FontSize="11" Margin="0,5,0,0" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右列：热门服务器推荐（上） + 最近玩过的服务器（下） -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- ================= 热门服务器推荐 ================= -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="热门服务器推荐" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="点击卡片查看详情，点「启动」直接进服" FontSize="11" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <!-- 热门榜筛选：玩法用标签页切换，「显示国外服务器」单独一个复选框 -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TabControl x:Name="HotCategoryTabs" Height="30" Style="{StaticResource HotTabControl}"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Left" Width="430"
                                    SelectionChanged="OnHotTabChanged">
                            <TabItem Header="全部" />
                            <TabItem Header="原版" />
                            <TabItem Header="模组服" />
                            <TabItem Header="小游戏" />
                            <TabItem Header="RPG" />
                            <TabItem Header="生存" />
                        </TabControl>
                        <CheckBox x:Name="HotShowOverseas" Content="显示国外服务器" FontSize="11"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Checked="OnHotFilterChanged" Unchecked="OnHotFilterChanged" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HotServerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                            Padding="14,12" Margin="0,0,0,10"
                                            MouseLeftButtonUp="OnHotServerCardClick" Tag="{Binding}"
                                            Cursor="Hand" ToolTip="点击查看服务器详情" Focusable="False">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                            <Border Width="46" Height="46" CornerRadius="10"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="18"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4"
                                                    Padding="5,1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                    Margin="0,0,-4,-4">
                                                <TextBlock Text="{Binding RankText}" FontSize="9" Foreground="White" />
                                            </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                                            Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RegionText}" FontSize="10"
                                                                   Foreground="{DynamicResource AccentHoverBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CategoryText}" FontSize="11" Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock FontSize="10" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}">
                                                    <Run Text="{Binding Address, Mode=OneWay}" />
                                                    <Run Text="　" />
                                                    <Run Text="{Binding Version, Mode=OneWay}" />
                                                    <Run Text="　" />
                                                    <Run Text="{Binding Loader, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="启动" Style="{StaticResource GhostButton}"
                                                    Padding="16,6" VerticalAlignment="Center"
                                                    Click="OnLaunchHotServer" Tag="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ================= 最近玩过的服务器 =================
                 按需求：只显示 图标 / 名称 / 信号等级；横向排列最多 6 个；
                 点头像 = 选中（卡片右下角出现勾选），语义同「直连」——自动把直连地址与账号切成这台需要的；
                 选中后要手动点「启动游戏」，不会自动启动。 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <!-- 固定行高：否则「移除所选」按钮出现/消失时会把卡片高度顶高 -->
                    <Grid MinHeight="32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="最近玩过的服务器" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="点头像选中＝自动适配直连地址与账号，再手动点「启动游戏」"
                                       FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Button x:Name="RemoveRecentButton" Content="移除所选" Style="{StaticResource OutlineButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden"
                                Click="OnRemoveSelectedRecent" />
                    </Grid>

                    <TextBlock x:Name="RecentEmptyText"
                               Text="还没有玩过的服务器：从「服务器列表」或上方推荐位启动一次就会出现在这里。"
                               FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <!-- 横向卡片：鼠标滚轮在这里滚动 = 横向滚动 -->
                    <ScrollViewer x:Name="RecentScroll" Margin="0,10,0,0" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnRecentWheel">
                        <ItemsControl x:Name="RecentServerList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="126" Margin="0,0,10,2" Padding="10,10,10,8" CornerRadius="10"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                                        <Grid>
                                            <StackPanel>
                                                <Border Width="56" Height="56" CornerRadius="12" Cursor="Hand"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        MouseLeftButtonUp="OnRecentAvatarClick" Tag="{Binding}"
                                                        ToolTip="点一下：把这台服务器设成直连目标（地址 + 账号）">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Margin="0,8,0,0" HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                    <views:SignalIcon Level="{Binding SignalLevel}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SignalText}" FontSize="11" Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 选中态：卡片右下角的勾选标记（未选中的卡片不显示） -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom" Visibility="{Binding CheckVisibility}">
                                                <Border Width="16" Height="16" CornerRadius="4"
                                                        Background="{DynamicResource AccentBrush}">
                                                    <Path Data="M 1,5 L 4,8 L 9,2" Stroke="White" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="直连" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentHoverBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>

        <!-- ================= 底部：游戏 Tips ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                        Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                    <TextBlock Text="i" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TipText" Grid.Column="1" Margin="10,0,10,0" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Grid.Column="2" Content="换一条" Style="{StaticResource LinkButton}"
                        VerticalAlignment="Center" Click="OnNextTip" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
