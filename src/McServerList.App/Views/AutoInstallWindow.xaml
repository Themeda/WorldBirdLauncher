<Window x:Class="McServerList.App.Views.AutoInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载并启动" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="36" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <TextBlock Text="下载并启动" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Content="✕" Style="{StaticResource CloseTitleBarButton}" HorizontalAlignment="Right"
                        Click="OnCancel" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="18,4,18,0">
                <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="游戏版本" FontSize="12" Width="68" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="GameVersionBox" Width="360" Height="32"
                              SelectionChanged="OnGameVersionChanged" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="加载器" FontSize="12" Width="68" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="LoaderBox" Width="150" Height="32" SelectionChanged="OnLoaderChanged" />
                    <ComboBox x:Name="LoaderVersionBox" Width="200" Height="32" Margin="10,0,0,0" IsEnabled="False" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="光影" FontSize="12" Width="68" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="ShaderBox" Width="150" Height="32" SelectionChanged="OnShaderChanged" />
                </StackPanel>

                <TextBlock x:Name="PlanText" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,16,18,16">
                <Button Content="取消" Style="{StaticResource GhostButton}" Padding="18,6" Margin="0,0,10,0"
                        Click="OnCancel" />
                <Button x:Name="InstallButton" Content="下载并启动" Style="{StaticResource PrimaryButton}"
                        Padding="18,6" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
