<Window x:Class="McServerList.App.Views.VersionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择游戏版本" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="36" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <TextBlock Text="选择游戏版本" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Content="✕" Style="{StaticResource CloseTitleBarButton}" HorizontalAlignment="Right"
                        Click="OnCancel" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="18,4,18,0">
                <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox x:Name="VersionBox" Height="32" Margin="0,12,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,16,18,16">
                <Button Content="取消" Style="{StaticResource GhostButton}" Padding="18,6" Margin="0,0,10,0"
                        Click="OnCancel" />
                <Button Content="使用这个版本" Style="{StaticResource PrimaryButton}" Padding="18,6" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
