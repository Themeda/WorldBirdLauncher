<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 双目标：net8.0-windows 给现有客户端；net48 给"小体积单 exe"那条路 -->
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- net48 的默认语言版本是 C# 7.3，这里显式用最新（集合表达式/记录/required 等） -->
    <LangVersion>latest</LangVersion>
    <!-- 机器上没装 4.8 开发包时，靠引用程序集包提供参考程序集 -->
    <AutomaticallyUseReferenceAssemblyPackages>true</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- net48 上这几个类型在"框架程序集"里，必须显式引用（不然会报 CS1069：类型已转发到 System.Net.Http/System.IO.Compression） -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- 平台无关的模型/协议/目录逻辑已抽到 McServerList.Shared（客户端与服务端共用） -->
  <ItemGroup>
    <ProjectReference Include="..\McServerList.Shared\McServerList.Shared.csproj" />
  </ItemGroup>

  <!-- WPF SDK 的隐式 using 集合不含 System.IO，这里补回 -->
  <ItemGroup>
    <Using Include="System.IO" />
    <!-- 兼容层的全局 using：net48 上缺的那批新 API 都在 Compat\NetCompat 里 -->
    <Using Include="McServerList.Core.Compat" />
  </ItemGroup>

  <!-- 让单元测试能直接验证内部解析/规划逻辑（版本 JSON 形状相关的回归用） -->
  <ItemGroup>
    <InternalsVisibleTo Include="McServerList.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- OptiFine 官方安装器的无界面转发类（源码见同名 .java，用 javac 编译到 Java 8） -->
    <EmbeddedResource Include="Launcher\OptiFine\OptiFineHeadless.class" />
    <None Include="Launcher\OptiFine\OptiFineHeadless.java" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
