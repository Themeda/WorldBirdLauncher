<Window x:Class="WorldBirdLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorldBirdLauncher.App.Views"
        Title="WorldBirdLauncher-Pro"
        Icon="Assets/app.ico"
        Height="680" Width="1040" MinHeight="600" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- 无边框标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="⛏" FontSize="11" Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleBrandText" Text="WorldBirdLauncher-Pro · 我的世界服务器列表" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="—" Style="{StaticResource TitleBarButton}" Click="OnMinimize" />
                    <Button Content="✕" Style="{StaticResource CloseTitleBarButton}" Click="OnClose" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧边导航 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,6,0,0">
                        <RadioButton x:Name="NavLaunch" Content="启动" Style="{StaticResource NavButton}"
                                     GroupName="Nav" IsChecked="True" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavServers" Content="服务器列表" Style="{StaticResource NavButton}"
                                     GroupName="Nav" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavSkin" Content="皮肤展示" Style="{StaticResource NavButton}"
                                     GroupName="Nav" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavDownload" Content="资源下载" Style="{StaticResource NavButton}"
                                     GroupName="Nav" Checked="OnNavChanged" />
                    </StackPanel>
                    <RadioButton x:Name="NavSettings" Grid.Row="1" Content="设置" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Margin="0,0,0,8" Checked="OnNavChanged" />
                </Grid>

                <!-- 内容区 -->
                <Grid Grid.Column="1" Margin="0,0,16,0">
                    <!-- 启动 -->
                    <views:LauncherPage x:Name="Launcher" />

                    <!-- 服务器列表 -->
                    <Grid x:Name="ServersPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                                                <WrapPanel Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
                            <ComboBox x:Name="SortBox" Width="104" Height="30" Margin="0,0,8,6"
                                      SelectionChanged="OnSortChanged">
                                <ComboBoxItem Content="按在线人数" IsSelected="True" />
                                <ComboBoxItem Content="按信号" />
                                <ComboBoxItem Content="按名称" />
                                <ComboBoxItem Content="按综合热度" />
                                <ComboBoxItem Content="收藏优先" />
                            </ComboBox>
                            <TextBox x:Name="SearchBox" Width="160" Height="30" Margin="0,0,8,6"
                                     TextChanged="OnSearchChanged"
                                     ToolTip="按名称、地址、介绍或已知模组搜索" />
                            <Button x:Name="VersionButton" Content="版本 ˅" Style="{StaticResource CompactChipButton}"
                                    Click="OnMoreVersions" />
                            <Popup x:Name="VersionPopup" PlacementTarget="{Binding ElementName=VersionButton}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                        BorderThickness="1" CornerRadius="10" Padding="10" Width="420">
                                    <StackPanel>
                                        <TextBlock Text="版本（可多选）" FontSize="11" Margin="0,0,0,6"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <ItemsControl ItemsSource="{Binding VersionChips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                              Visibility="{Binding Visibility}"
                                                              Style="{StaticResource CompactChipStyle}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="清除版本" Style="{StaticResource LinkButton}"
                                                HorizontalAlignment="Right" Click="OnClearVersions" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,6">
                                <TextBlock Text="专属" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                           ToolTip="专属客户端"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <ItemsControl ItemsSource="{Binding CustomClientChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                      Style="{StaticResource CompactChipStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,6">
                                <TextBlock Text="白名单" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <ItemsControl ItemsSource="{Binding WhitelistChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                      Style="{StaticResource CompactChipStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,6">
                                <TextBlock Text="正版" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                           ToolTip="正版验证"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <ItemsControl ItemsSource="{Binding PremiumChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                      Style="{StaticResource CompactChipStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Button x:Name="FilterDrawerButton" Content="筛选 ˅" Style="{StaticResource CompactChipButton}"
                                    Click="OnToggleFilterDrawer" />
                            <Button x:Name="RefreshStatusButton" Content="刷新状态" Style="{StaticResource GhostButton}"
                                    Height="30" Padding="12,4" Margin="0,0,6,6" Click="OnRefreshStatus" />
                            <ProgressBar x:Name="RefreshProgress" Width="60" Height="5" Margin="0,0,0,6"
                                         VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
                        </WrapPanel>
                        <ScrollViewer x:Name="ServerListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="OnServerListScroll">
                            <StackPanel>
                    <Border x:Name="FilterDrawer" Visibility="Collapsed" Style="{StaticResource Card}"
                            Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Left" Text="加载器" Width="46" FontSize="11"
                                           VerticalAlignment="Top" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <ItemsControl ItemsSource="{Binding LoaderChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                      Visibility="{Binding Visibility}"
                                                      Style="{StaticResource ChipStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Left" Text="线路" Width="46" FontSize="11"
                                           VerticalAlignment="Top" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <ItemsControl ItemsSource="{Binding LineChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                      Visibility="{Binding Visibility}"
                                                      Style="{StaticResource ChipStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Left" Text="玩法" Width="46" FontSize="11"
                                           VerticalAlignment="Top" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <Button x:Name="MoreCategoriesButton" DockPanel.Dock="Right" Content="更多 ˅"
                                        Style="{StaticResource ChipButton}" Margin="6,0,0,6"
                                        VerticalAlignment="Top" Click="OnMoreCategories" />
                                <ItemsControl ItemsSource="{Binding CategoryChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                      Visibility="{Binding Visibility}"
                                                      Style="{StaticResource ChipStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Left" Text="热门模组" Width="46" FontSize="11"
                                           VerticalAlignment="Top" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <ItemsControl ItemsSource="{Binding ModGroupChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                      Visibility="{Binding Visibility}"
                                                      Style="{StaticResource ChipStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Left" Text="延迟" Width="46" FontSize="11"
                                           VerticalAlignment="Top" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <ItemsControl ItemsSource="{Binding LatencyChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                      Visibility="{Binding Visibility}"
                                                      Style="{StaticResource ChipStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="46,2,0,0">
                                <CheckBox x:Name="FavoritesOnly" DockPanel.Dock="Left" Content="只看收藏" FontSize="12"
                                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0"
                                          VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Left" Content="重置筛选" Style="{StaticResource LinkButton}"
                                        Click="OnResetFilters" />
                                <TextBlock x:Name="FilterResultText" DockPanel.Dock="Right" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{DynamicResource AccentHoverBrush}"
                                           Text="筛选结果：0个" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                            <ItemsControl ItemsSource="{Binding Servers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- 固定 2 列，卡片宽度自动撑满展示区 -->
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,12,12" Background="{DynamicResource SurfaceBrush}"
                                                CornerRadius="12" BorderBrush="{DynamicResource BorderBrush2}"
                                                BorderThickness="1" MouseLeftButtonUp="OnCardClick" Cursor="Hand"
                                                Tag="{Binding}" Focusable="False"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top">
                                            <Grid Margin="14">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="8"
                                                            Background="{DynamicResource AccentSoftBrush}">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}" FontSize="18"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image Source="{Binding Icon}" Stretch="Uniform" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- 角标：广告卡显示「推广」；用了置顶卡的服务器显示「置顶」（刷新卡按用户要求不标记） -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="#FFF4E5" CornerRadius="4"
                                                                        Padding="5,1" Margin="0,0,6,0"
                                                                        Visibility="{Binding AdBadgeVisibility}">
                                                                    <TextBlock Text="推广" FontSize="10" Foreground="#B7791F" />
                                                                </Border>
                                                                <Border Background="#EEF0FF" CornerRadius="4"
                                                                        Padding="5,1" Margin="0,0,6,0"
                                                                        Visibility="{Binding TopBadgeVisibility}">
                                                                    <TextBlock Text="置顶" FontSize="10" Foreground="#5B5BD6" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Cursor="Hand" ToolTip="点击复制服务器名称"
                                                                       MouseLeftButtonUp="OnCopyServerName"
                                                                       Tag="{Binding}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding EndPoint}" FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" MinWidth="90">
                                                        <TextBlock Text="{Binding PlayersText}" FontSize="14"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="{Binding LatencyText}" FontSize="11"
                                                                   HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                                            <Setter Property="Foreground" Value="#C0392B" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- 信号文字后面跟三格信号图标（离线时左下角红叉） -->
                                                        <views:SignalIcon Level="{Binding DisplaySignalLevel}" HorizontalAlignment="Right"
                                                                          Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                                            Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding RegionText}" FontSize="10"
                                                                   Foreground="{DynamicResource AccentHoverBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource BgBrush}" CornerRadius="4"
                                                            Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Version}" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource BgBrush}" CornerRadius="4"
                                                            Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Loader}" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding Categories}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#EAF7F1" CornerRadius="4" Padding="6,2"
                                                                        Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding}" FontSize="10"
                                                                               Foreground="{DynamicResource SuccessBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Visibility="{Binding NoAddressVisibility}" Background="#FDECEC"
                                                            CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="无直连地址" FontSize="10" Foreground="#C0392B" />
                                                    </Border>
                                                    <Border Visibility="{Binding CustomClientVisibility}" Background="#FFF6E5"
                                                            CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="需专属客户端" FontSize="10" Foreground="#B7791F" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- 原来这里是"简介"（Description）。按用户要求改成显示服务端采样到的 MOTD：
                                                     解析 § 颜色代码与换行；没有 MOTD 时整行收起（Visibility 绑定）。 -->
                                                <views:MotdTextBlock Grid.Row="2" Motd="{Binding Motd}"
                                                                     Visibility="{Binding MotdVisibility}"
                                                                     Margin="0,8,0,0"
                                                                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                     Height="34" FontSize="11"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}" />

                                                <Grid Grid.Row="3" Margin="0,10,0,0">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <Button Content="启动" Style="{StaticResource PrimaryButton}"
                                                                Padding="18,6" Click="OnLaunchServer" Tag="{Binding}"
                                                                IsEnabled="{Binding HasAddress}" />
                                                        <Button Content="复制 IP" Style="{StaticResource GhostButton}"
                                                                Margin="8,0,0,0" Padding="12,6" Click="OnCopyIp" Tag="{Binding}"
                                                                IsEnabled="{Binding HasAddress}" />
                                                        <Button Content="官网" Style="{StaticResource GhostButton}"
                                                                Margin="8,0,0,0" Padding="12,6" Click="OnOpenOfficialSite"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding HasOfficialSite, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <!-- 右下角：收藏；推广卡额外给一个「不感兴趣」 -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom">
                                                        <Button Content="不感兴趣" Margin="0,0,10,0"
                                                                Style="{StaticResource LinkButton}"
                                                                Visibility="{Binding AdActionVisibility}"
                                                                Click="OnAdNotInterested" Tag="{Binding}" />
                                                        <Button Content="{Binding FavoriteButtonText}"
                                                                Style="{StaticResource LinkButton}"
                                                                Click="OnToggleFavorite" Tag="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 增量渲染的状态提示 -->
                        <TextBlock x:Name="ListFooter" Grid.Row="2" FontSize="11" Margin="4,6,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" />

                        <!-- 筛选/排序时的 loading 遮罩 -->
                        <Grid x:Name="ListBusyOverlay" Grid.Row="1" Background="#66FFFFFF" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="160" Height="6" IsIndeterminate="True" />
                                <TextBlock Text="正在筛选…" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- 回到置顶 -->
                        <!-- 无数据（既没缓存又连不上服务端）时的空状态 -->
                        <Grid x:Name="ListEmptyOverlay" Grid.Row="1" Background="#F7FAFC" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                <TextBlock Text="还没有服务器列表数据" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="ListEmptyHint"
                                           Text="正在向服务端请求；如果一直失败，请检查网络后点下面的「重试」。"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <Button Content="重试" Style="{StaticResource PrimaryButton}" Padding="20,7"
                                        HorizontalAlignment="Center" Margin="0,14,0,0" Click="OnRetryCatalog" />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="BackToTopButton" Grid.Row="1" Content="↑ 置顶"
                                Style="{StaticResource PrimaryButton}" Padding="14,8" FontSize="12"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18"
                                Visibility="Collapsed" Opacity="0.9" Click="OnBackToTop" />

                        <!-- 详情浮层：灰色半透明遮罩，点击外部关闭 -->
                        <Grid x:Name="DetailOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#66000000"
                              Visibility="Collapsed" PreviewMouseLeftButtonUp="OnOverlayBackdropClick">
                            <Border x:Name="DetailCard" Width="560" MaxHeight="520"
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="14" Padding="22"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Border Width="52" Height="52" CornerRadius="10" Cursor="Hand"
                                                ToolTip="查看大图"
                                                MouseLeftButtonUp="OnDetailIconClick"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <Grid>
                                                <TextBlock Text="{Binding SelectedServer.Initial}" FontSize="22"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding SelectedServer.Icon}" Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0">
                                            <TextBlock Text="{Binding SelectedServer.Name}" FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Cursor="Hand" ToolTip="点击复制服务器名称"
                                                       MouseLeftButtonUp="OnCopyServerName"
                                                       Tag="{Binding SelectedServer}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding SelectedServer.EndPoint}" FontSize="12"
                                                       Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center">
                                                    <Run Text="在线 " /><Run Text="{Binding SelectedServer.PlayersText, Mode=OneWay}" />
                                                    <Run Text="　网络 " /><Run Text="{Binding SelectedServer.LatencyText, Mode=OneWay}" />
                                                    <Run Text="　版本 " /><Run Text="{Binding SelectedServer.Version, Mode=OneWay}" />
                                                </TextBlock>
                                                <views:SignalIcon Level="{Binding SelectedServer.DisplaySignalLevel, Mode=OneWay}"
                                                                  Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- 本机实测 vs 服务端采样（用户 2026-10-10：列表按信号用本机实测，详情页要能看到两者） -->
                                            <TextBlock Text="{Binding SelectedServer.SignalCompareText, Mode=OneWay}" FontSize="11"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <!-- 已下架但保留（收藏/玩过的）：给个说明 + 手动移除 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding SelectedServer.IsRetained, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding SelectedServer.RetainedHint}" FontSize="11"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="#C0392B" />
                                                <Button Content="从我的列表移除" Style="{StaticResource LinkButton}"
                                                        Margin="10,0,0,0" VerticalAlignment="Center"
                                                        Click="OnRemoveRetained" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <ScrollViewer x:Name="DetailScroll" Grid.Row="1" Margin="0,16,0,0"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- 服务端采样到的 MOTD：详情页显示完整内容（颜色 + 换行） -->
                                            <TextBlock Text="服务器 MOTD" FontSize="13" FontWeight="SemiBold"
                                                       Margin="0,0,0,8"
                                                       Visibility="{Binding SelectedServer.MotdVisibility}" />
                                            <!-- 最近活跃：只有用过刷新卡的服务器才显示（用户 2026-10-09 要求） -->
                                            <TextBlock Text="{Binding SelectedServer.LastActiveText}" FontSize="12"
                                                       Margin="0,0,0,10" Foreground="{DynamicResource TextMutedBrush}"
                                                       Visibility="{Binding SelectedServer.LastActiveVisibility}" />
                                            <Border Background="{DynamicResource BgBrush}" CornerRadius="8"
                                                    Padding="12" Margin="0,0,0,16"
                                                    Visibility="{Binding SelectedServer.MotdVisibility}">
                                                <views:MotdTextBlock Motd="{Binding SelectedServer.Motd}"
                                                                     TextWrapping="Wrap" FontSize="12"
                                                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </Border>

                                            <!-- 服务器地址：多线路整合展示，可复制 / 单独 Ping / 指定直连线路 -->
                                            <Grid>
                                                <TextBlock Text="服务器地址" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Button Content="测试线路延迟" Style="{StaticResource OutlineButton}"
                                                        HorizontalAlignment="Right" Click="OnPingAllAddresses" />
                                            </Grid>
                                            <Border Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="12"
                                                    Margin="0,6,0,0">
                                                <ItemsControl ItemsSource="{Binding DetailAddresses}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                                                        Padding="6,2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding LabelText}" FontSize="10"
                                                                               Foreground="{DynamicResource AccentHoverBrush}" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding EndPoint}" FontSize="12"
                                                                           Margin="10,0,10,0" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="10"
                                                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                                    <Button Content="复制地址" Style="{StaticResource GhostButton}"
                                                                            Padding="10,3" FontSize="11" Margin="0,0,8,0"
                                                                            Click="OnCopyAddress" Tag="{Binding}" />
                                                                    <Button Content="设为直连" Style="{StaticResource GhostButton}"
                                                                            Padding="10,3" FontSize="11"
                                                                            Visibility="{Binding NotPreferredVisibility}"
                                                                            Click="OnSetPreferredRoute" Tag="{Binding}" />
                                                                    <Button Content="当前直连" Style="{StaticResource PrimaryButton}"
                                                                            Padding="10,3" FontSize="11"
                                                                            Visibility="{Binding PreferredVisibility}"
                                                                            Click="OnSetPreferredRoute" Tag="{Binding}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>

                                            <!-- 收录信息：固定字段集中展示，便于进服前判断 -->
                                            <TextBlock Text="收录信息" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Border Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="14,12"
                                                    Margin="0,6,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="正版验证" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedServer.PremiumText}"
                                                               FontSize="11" Margin="10,0,24,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="白名单" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedServer.WhitelistText}"
                                                               FontSize="11" Margin="10,0,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="登录方式" FontSize="11"
                                                               Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedServer.LoginModeText}"
                                                               FontSize="11" Margin="10,10,24,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="服务器类型" FontSize="11"
                                                               Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedServer.ServerTypeText}"
                                                               FontSize="11" Margin="10,10,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="线路" FontSize="11"
                                                               Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedServer.LinesText}"
                                                               FontSize="11" Margin="10,10,24,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="评分" FontSize="11"
                                                               Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedServer.RatingText}"
                                                               FontSize="11" Margin="10,10,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="数据来源" FontSize="11"
                                                               Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                                               Text="{Binding SelectedServer.SourceNameText}" FontSize="11"
                                                               Margin="10,10,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <!-- 服务端软件（Ping 返回，如 Velocity 代理）；与数据里的游戏版本不同才显示 -->
                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="服务端软件" FontSize="11"
                                                               Margin="0,10,0,0"
                                                               Visibility="{Binding SelectedServer.SoftwareVisibility}"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                                                               Text="{Binding SelectedServer.SoftwareText}" FontSize="11"
                                                               Margin="10,10,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding SelectedServer.SoftwareVisibility}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <!-- 跨版本服务器：显示支持版本区间 -->
                                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="支持版本" FontSize="11"
                                                               Margin="0,10,0,0"
                                                               Visibility="{Binding SelectedServer.VersionRangeVisibility}"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                                                               Text="{Binding SelectedServer.VersionRangeText}" FontSize="11"
                                                               Margin="10,10,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding SelectedServer.VersionRangeVisibility}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding SelectedServer.AddressHint}" TextWrapping="Wrap"
                                                       FontSize="11" Margin="0,8,0,0" Foreground="#C0392B"
                                                       Visibility="{Binding SelectedServer.NoAddressVisibility}" />

                                            <!-- 联系方式与专属客户端 -->
                                            <TextBlock Text="进入方式 / 联系方式" FontSize="13" FontWeight="SemiBold"
                                                       Margin="0,14,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Border Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="12"
                                                    Margin="0,6,0,0">
                                                <StackPanel>
                                                    <TextBlock FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="官网：" /><Run Text="{Binding SelectedServer.OfficialSiteText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="QQ 群：" /><Run Text="{Binding SelectedServer.QqGroupText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <!-- 专属客户端：支持多条网盘链接，每行可单独打开 -->
                                                    <ItemsControl ItemsSource="{Binding SelectedServer.ClientDownloads}" Margin="0,6,0,0"
                                                                  Visibility="{Binding SelectedServer.HasClientDownloads, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <TextBlock FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               Text="{Binding DisplayText}" />
                                                                    <Button Content="下载" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                                                                            VerticalAlignment="Center" Click="OnOpenClientDownloadItem"
                                                                            Tag="{Binding}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Button Content="打开官网" Style="{StaticResource GhostButton}"
                                                                Padding="12,4" Click="OnOpenOfficialSiteSelected"
                                                                Visibility="{Binding SelectedServer.HasOfficialSite, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Content="复制 QQ 群" Style="{StaticResource GhostButton}"
                                                                Margin="8,0,0,0" Padding="12,4" Click="OnCopyQqGroup"
                                                                Visibility="{Binding SelectedServer.HasQqGroup, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Content="下载客户端" Style="{StaticResource GhostButton}"
                                                                Margin="8,0,0,0" Padding="12,4" Click="OnOpenClientDownload"
                                                                Visibility="{Binding SelectedServer.HasClientDownload, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- 服务器介绍：文字 + 图片 -->
                                            <TextBlock Text="服务器介绍" FontSize="13" FontWeight="SemiBold"
                                                       Margin="0,14,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <views:MarkupTextBlock Markup="{Binding SelectedServer.LongDescription}"
                                                                   BaseUrl="{Binding SelectedServer.SourceUrl}"
                                                                   TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                                                   LinkClicked="OnIntroLinkClicked"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                                            <ItemsControl ItemsSource="{Binding SelectedServer.ScreenshotUrls}" Margin="0,8,0,0"
                                                          Visibility="{Binding SelectedServer.HasScreenshots, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding}" Width="230" Height="130"
                                                               Cursor="Hand" ToolTip="点击查看大图"
                                                               MouseLeftButtonUp="OnScreenshotClick"
                                                               Stretch="UniformToFill" Margin="0,0,8,8" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="当前在线玩家" FontSize="13" FontWeight="SemiBold"
                                                       Margin="0,14,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding SelectedServer.PlayersListHint}" FontSize="10"
                                                       Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource AccentHoverBrush}" />
                                            <TextBlock Text="{Binding SelectedServer.PlayersListText}" TextWrapping="Wrap"
                                                       FontSize="11" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="地图 / 插件" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="地图：" /><Run Text="{Binding SelectedServer.MapText, Mode=OneWay}" />
                                                <Run Text="　插件：" /><Run Text="{Binding SelectedServer.PluginsText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                        </ScrollViewer>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="启动游戏" Style="{StaticResource PrimaryButton}"
                                                Click="OnLaunchServerSelected"
                                                IsEnabled="{Binding SelectedServer.HasAddress}" />
                                        <Button Content="复制 IP" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                Click="OnCopyIpSelected"
                                                IsEnabled="{Binding SelectedServer.HasAddress}" />
                                        <Button Content="关闭" Style="{StaticResource LinkButton}" Margin="4,0,0,0"
                                                Click="OnCloseDetail" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 设置 -->
                    <views:SettingsPage x:Name="Settings" Visibility="Collapsed" />

                    <!-- 资源下载 -->
                    <views:DownloadPage x:Name="Download" Visibility="Collapsed" />

                    <!-- 皮肤展示 -->
                    <views:SkinPage x:Name="Skin" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- 最底部提示行：左边是通用状态消息（载入/刷新…），右边是启动页的提示与进度文字
                 （「已选中 xxx…」「正在下载…」这类）。启动页按钮下方不再重复显示提示文字。 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBar" Grid.Column="0" Margin="16,0,12,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           Text="正在加载内置服务器数据…" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LauncherHintBar" Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center"
                           FontSize="11" MaxWidth="620" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 后台下载：右下角悬浮按钮（点击进入下载管理） -->
            <Border x:Name="DownloadBadge" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,30,26" Background="{DynamicResource AccentBrush}" CornerRadius="16" Padding="16,12"
                    Cursor="Hand" MouseLeftButtonUp="OnDownloadBadgeClick" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="后台下载中" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="DownloadBadgeText" FontSize="11" Foreground="White" Margin="0,2,0,0" />
                    <ProgressBar x:Name="DownloadBadgeProgress" Width="150" Height="4" Minimum="0" Maximum="100"
                                 Margin="0,5,0,0" Background="#44FFFFFF" Foreground="White" />
                </StackPanel>
            </Border>

            <!-- 后台下载全部完成的气泡通知 -->
            <Border x:Name="DownloadToast" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,30,130" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,12"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Visibility="Collapsed">
                <TextBlock x:Name="DownloadToastText" FontSize="12" TextWrapping="Wrap" MaxWidth="280"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>

            <!-- 复制操作提示：顶部居中胶囊，完整显示 1 秒后再渐隐 1 秒 -->
            <Border x:Name="CopyToast" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="300"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,54,0,0"
                    Background="{DynamicResource AccentBrush}" CornerRadius="16" Padding="14,7"
                    IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
                <TextBlock x:Name="CopyToastText" FontSize="12" FontWeight="SemiBold"
                           Foreground="White" MaxWidth="520" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- 服务器详情大图查看：覆盖整个启动器窗口（含标题栏/侧栏） -->
            <Grid x:Name="ImageViewerOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#E6000000"
                  Visibility="Collapsed" Panel.ZIndex="200"
                  MouseLeftButtonUp="OnImageViewerBackdropClick" PreviewMouseWheel="OnImageViewerWheel">
                <Canvas x:Name="ImageViewerCanvas" ClipToBounds="True" Background="Transparent">
                    <Image x:Name="ViewerImage" Stretch="Fill" RenderTransformOrigin="0,0" Cursor="Hand"
                           MouseLeftButtonDown="OnViewerImageMouseDown"
                           MouseMove="OnViewerImageMouseMove"
                           MouseLeftButtonUp="OnViewerImageMouseUp">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ViewerScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="ViewerTranslate" X="0" Y="0" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
                <TextBlock x:Name="ViewerCounter" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="20,18,0,0" FontSize="12" Foreground="#D9FFFFFF" IsHitTestVisible="False" />
                <Button x:Name="ViewerPrev" Content="‹" Width="38" Height="56" FontSize="26" Padding="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"
                        Style="{StaticResource GhostButton}" Click="OnViewerPrev" Visibility="Collapsed" />
                <Button x:Name="ViewerNext" Content="›" Width="38" Height="56" FontSize="26" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"
                        Style="{StaticResource GhostButton}" Click="OnViewerNext" Visibility="Collapsed" />
                <Button Content="✕" Style="{StaticResource CloseTitleBarButton}" Width="36" Height="32"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0"
                        Click="OnCloseImageViewer" ToolTip="关闭（Esc）" />
                <StackPanel x:Name="ViewerLoading" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <ProgressBar Width="160" Height="6" IsIndeterminate="True" />
                    <TextBlock Text="图片加载中…" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"
                               Foreground="#D9FFFFFF" />
                </StackPanel>
                <TextBlock x:Name="ViewerError" Text="图片加载失败，请关闭后重试。"
                           FontSize="14" Foreground="#FFD7D7" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
