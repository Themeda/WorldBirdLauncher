<UserControl x:Class="WorldBirdLauncher.App.Views.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- 下载入口 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="资源下载 / 下载管理" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="下载在后台进行，关掉窗口也会继续；进度会显示在右下角悬浮按钮上。"
                               FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="InstallGameButton" Content="安装游戏版本…" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,10,10" Padding="18,8" Click="OnInstallGame" />
                        <Button Content="下载模组 / 光影包…" Style="{StaticResource GhostButton}"
                                Margin="0,0,10,10" Padding="18,8" Click="OnDownloadMods" />
                        <Button Content="打开游戏目录" Style="{StaticResource GhostButton}"
                                Margin="0,0,10,10" Padding="18,8" Click="OnOpenGameFolder" />
                        <Button Content="打开日志" Style="{StaticResource GhostButton}"
                                Margin="0,0,10,10" Padding="18,8" Click="OnOpenLog" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="同时下载任务数" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox x:Name="ConcurrencyBox" Width="70" Height="28" Margin="8,0,0,0"
                                  SelectionChanged="OnConcurrencyChanged">
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                        </ComboBox>
                        <TextBlock Text="（默认 2 个并行，可随时调整）" FontSize="11" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <!-- 分类进度 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="分类进度" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <!-- 每一类：标题+状态 → 当前文件（含单文件进度） → 进度条 -->
                    <ItemsControl ItemsSource="{Binding Categories}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding DetailText}" FontSize="11" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Grid>
                                    <TextBlock Text="{Binding CurrentFileText}" FontSize="11" Margin="0,3,0,0"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AccentHoverBrush}"
                                               Visibility="{Binding HasCurrentFile, Converter={StaticResource BoolToVisibility}}" />
                                    <ProgressBar Height="8" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding Percentage, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 任务列表 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="下载任务" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Content="清除已结束" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                Click="OnClearFinished" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Margin="0,0,90,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" HorizontalAlignment="Right"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                        <!-- 左侧：当前文件；右侧：下载中 · 速度（x/y 个文件） -->
                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding CurrentFileText}" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource AccentHoverBrush}"
                                                           ToolTip="{Binding CurrentFileText}" />
                                                <TextBlock Text="{Binding Message}" FontSize="11" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StageText}" FontSize="11"
                                                       Margin="12,0,0,0" TextWrapping="NoWrap" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                        <Grid Grid.Row="2" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                         Value="{Binding Percentage, Mode=OneWay}" VerticalAlignment="Center"
                                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                                            <Button Grid.Column="1" Content="取消" Style="{StaticResource LinkButton}"
                                                    Margin="10,0,0,0" Click="OnCancelTask" Tag="{Binding}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}"
                               Text="（暂无下载任务）"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,20">
                <StackPanel>
                    <TextBlock Text="说明" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="InstallGameHelp" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="· 安装游戏版本：可选原版 / Forge / Fabric，支持 Iris 与 OptiFine 光影；版本名可自定义，同一游戏版本可装多份（重名会提示覆盖）。" />
                    <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="· 下载模组 / 光影包：数据源 Modrinth，按目标版本的加载器自动匹配；模组进 mods，光影包进 shaderpacks。" />
                    <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="· 下载失败原因记录在日志里（点上方「打开日志」）。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
