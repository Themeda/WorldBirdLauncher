<Window x:Class="WorldBirdLauncher.App.Views.JavaSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检测 Java 运行时" Height="440" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="38" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <TextBlock Text="检测 Java 运行时" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="SearchTitle" Grid.Row="0" Text="正在搜索本机的 Java…" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <ProgressBar x:Name="SearchProgress" Grid.Row="1" Height="6" Margin="0,10,0,0"
                             IsIndeterminate="True" />
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Margin="0,12,0,0"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="10">
                        <TextBlock x:Name="LogText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,12,20,18" HorizontalAlignment="Right">
                <TextBlock x:Name="SummaryText" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <Button x:Name="DeepScanButton" Content="深度扫描（30 秒）" Style="{StaticResource GhostButton}"
                        Padding="16,6" Margin="0,0,10,0" IsEnabled="False" Click="OnDeepScan" />
                <Button x:Name="DoneButton" Content="完成" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                        Padding="20,6" Click="OnDone" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
