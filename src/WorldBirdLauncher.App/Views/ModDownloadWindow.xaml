<Window x:Class="WorldBirdLauncher.App.Views.ModDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载模组" Height="560" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="38" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
            <TextBlock Text="下载模组 / 光影包" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Content="✕" Style="{StaticResource CloseTitleBarButton}" HorizontalAlignment="Right"
                    Click="OnClose" />
        </Grid>

        <Grid Grid.Row="1" Margin="18,0,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="从 Modrinth 搜索并下载模组" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Grid.Row="1" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}"
                   Text="模组会按目标版本的加载器自动匹配，下载到该版本的 mods 目录。" />

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="下载类型" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox x:Name="KindBox" Width="110" Height="30" Margin="8,0,0,0">
                    <ComboBoxItem Content="模组" IsSelected="True" />
                    <ComboBoxItem Content="光影包" />
                </ComboBox>
                <TextBlock Text="目标版本" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox x:Name="TargetVersionBox" Width="200" Height="30" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox x:Name="SearchBox" Width="360" Height="30" ToolTip="模组/光影包名称，例如 JEI、Complementary" />
                <Button Content="搜索" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnSearch" />
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="ResultList" Grid.Row="3" Margin="0,10,0,0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4" MaxWidth="470">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock FontSize="11" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="460"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}">
                            <Run Text="作者 " /><Run Text="{Binding Author, Mode=OneWay}" />
                            <Run Text="　下载 " /><Run Text="{Binding DownloadsText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="DownloadButton" Content="下载选中模组" Style="{StaticResource PrimaryButton}"
                        Click="OnDownload" />
                <Button Content="打开 mods 目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="OnOpenMods" />
                <Button Content="关闭" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Click="OnClose" />
            </StackPanel>
        </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
