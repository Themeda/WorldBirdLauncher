<UserControl x:Class="WorldBirdLauncher.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid>
        <TabControl x:Name="SettingsTabs" Margin="0,0,0,58" Background="Transparent"
                    BorderThickness="0">
            <TabItem Header="外观" PreviewMouseLeftButtonDown="OnSettingsTabMouseDown">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="界面主题" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="选择浅色、深色或跟随系统；切换后立即预览。"
                                           FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <ComboBox x:Name="ThemeBox" Height="32" Margin="0,10,0,0" MaxWidth="220"
                                          HorizontalAlignment="Left" SelectionChanged="OnThemeChanged">
                                    <ComboBoxItem Content="浅色" />
                                    <ComboBoxItem Content="深色" />
                                    <ComboBoxItem Content="跟随系统" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="主题颜色" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="自定义强调色会应用到按钮、选中态、链接与高亮。点击按钮打开 Windows 系统选色盘。"
                                           FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Border x:Name="AccentPreview" Width="34" Height="34" CornerRadius="8"
                                            Background="{DynamicResource AccentBrush}"
                                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" />
                                    <TextBox x:Name="AccentColorBox" Width="100" Height="34" Margin="10,0,0,0"
                                             IsReadOnly="True" ToolTip="当前强调色" />
                                    <Button Content="选择颜色…" Style="{StaticResource GhostButton}"
                                            Height="34" Margin="10,0,0,0" Click="OnPickAccentColor" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="窗口与托盘" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="启动游戏后可以把窗口收进系统托盘，游戏退出时再自动显示回来。"
                                           FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <CheckBox x:Name="TrayAfterLaunchBox" Content="启动游戏后最小化到托盘（游戏退出后自动显示）"
                                          Margin="0,10,0,0" FontSize="12"
                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                                <CheckBox x:Name="TrayOnCloseBox" Content="点击关闭按钮时最小化到托盘而非退出（只有托盘菜单能真正退出）"
                                          Margin="0,8,0,0" FontSize="12"
                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="启动与 Java" PreviewMouseLeftButtonDown="OnSettingsTabMouseDown">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="游戏目录" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text=".minecraft 所在目录，留空则自动探测"
                                           FontSize="11" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GameDirBox" Height="32" />
                                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Click="OnBrowseGameDir" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="版本与运行时" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="从本机已有版本中选择；此页面不再提供游戏版本安装。"
                                           FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="游戏版本" FontSize="11" Margin="0,10,0,4"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="VersionBox" Height="32" SelectionChanged="OnVersionPicked" />
                                <TextBlock x:Name="IncompleteVersionsText" FontSize="11" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           Foreground="{DynamicResource WarningBrush}" />
                                <TextBlock Text="Java 版本" FontSize="11" Margin="0,10,0,4"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="JavaBox" Height="32" SelectionChanged="OnJavaPicked" />
                                <TextBlock x:Name="JavaHintText" FontSize="11" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="内存(MB)" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox x:Name="MemoryBox" Width="80" Height="30" Margin="8,0,0,0"
                                             TextChanged="OnMemoryTextChanged" />
                                    <CheckBox x:Name="IsolationBox" Content="版本隔离" FontSize="11"
                                              Margin="12,0,0,0" VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <CheckBox x:Name="AutoMemoryBox" Content="自动按物理内存推荐" FontSize="11"
                                              Margin="12,0,0,0" VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Slider x:Name="MemorySlider" Minimum="128" Maximum="32768" Value="4096"
                                        TickFrequency="128" IsSnapToTickEnabled="True" SmallChange="128"
                                        LargeChange="512" Margin="0,4,0,0" ValueChanged="OnMemorySliderChanged" />
                                <TextBlock x:Name="MemoryRangeText" FontSize="10" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="启动后自动进入的服务器（可选，格式 ip 或 ip:端口）"
                                           FontSize="11" Margin="0,10,0,4"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="ServerAddressBox" Height="30" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="下载与网络" PreviewMouseLeftButtonDown="OnSettingsTabMouseDown">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="下载与数据源" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <CheckBox x:Name="MirrorBox" Content="使用 BMCLAPI 镜像下载资源与 Java（国内推荐）"
                                          Margin="0,10,0,0" FontSize="12"
                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                                <CheckBox x:Name="QueryBox" Content="启用 Query 协议补充查询（服务端未开启时自动跳过）"
                                          Margin="0,8,0,0" FontSize="12"
                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="状态缓存时长（秒）" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox x:Name="CacheBox" Width="80" Height="30" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="服务器列表数据" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="立即刷新" Style="{StaticResource PrimaryButton}"
                                            Click="OnRefreshCatalog" />
                                    <Button Content="提交服务器" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Click="OnSubmitServer" />
                                </StackPanel>
                                <TextBlock x:Name="CatalogStatus" FontSize="11" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="维护" PreviewMouseLeftButtonDown="OnSettingsTabMouseDown">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="本地维护" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="这些操作作用于启动页当前选中的版本；游戏本体请使用官方启动器或其他来源安装。"
                                           FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="刷新已安装版本" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" Click="OnMaintenance" Tag="refresh" />
                                    <Button Content="导入整合包" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" Click="OnMaintenance" Tag="modpack" />
                                    <Button Content="检测 Java" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" Click="OnMaintenance" Tag="javadetect" />
                                    <Button Content="下载适配 Java" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" Click="OnMaintenance" Tag="javadownload" />
                                    <Button Content="打开游戏目录" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" Click="OnMaintenance" Tag="openfolder" />
                                    <Button Content="检查完整性" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" Click="OnMaintenance" Tag="verify" />
                                </WrapPanel>
                                <TextBlock x:Name="MaintenanceStatus" FontSize="11" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                                <ProgressBar x:Name="MaintenanceProgress" Height="4" Margin="0,8,0,0"
                                             IsIndeterminate="True" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="关于" PreviewMouseLeftButtonDown="OnSettingsTabMouseDown">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="关于 WorldBirdLauncher" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="账户信息经 Windows DPAPI 加密保存，不会明文落盘。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,8,8" Background="Transparent">
            <TextBlock x:Name="SaveStatus" FontSize="11" Margin="0,0,12,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" />
            <Button Content="保存设置" Style="{StaticResource PrimaryButton}" MinWidth="96"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</UserControl>
