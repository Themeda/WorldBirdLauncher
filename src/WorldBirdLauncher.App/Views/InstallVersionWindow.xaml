<Window x:Class="WorldBirdLauncher.App.Views.InstallVersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装游戏版本" Height="580" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 与主窗口一致的无边框标题栏 -->
        <Grid Grid.Row="0" Height="38" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
            <TextBlock Text="安装游戏版本" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Content="✕" Style="{StaticResource CloseTitleBarButton}" HorizontalAlignment="Right"
                    Click="OnCancel" />
        </Grid>

        <Grid Grid.Row="1" Margin="20,0,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择要安装的内容" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Grid.Row="1" Text="三行分别选择：游戏版本 / 加载器 / 光影；不安装的项选「不安装」即可。"
                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}" />

        <!-- 第一行：游戏版本（可输入） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="游戏版本" FontSize="12" Width="64" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox x:Name="GameVersionBox" Width="330" Height="32" IsEditable="True"
                      IsTextSearchEnabled="True" MaxDropDownHeight="240"
                      SelectionChanged="OnGameVersionChanged">
                <!-- 可编辑下拉框内部的 TextBox 会继承全局输入框模板（自定义 PART_ContentHost），
                     导致选中后文字在框内不可见；这里用朴素模板覆盖掉。 -->
                <ComboBox.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="2,0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.Resources>
            </ComboBox>
            <TextBlock x:Name="InstalledHint" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <!-- 第二行：加载器 + 版本（只列适配该游戏版本的） -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="加载器" FontSize="12" Width="64" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox x:Name="LoaderBox" Width="140" Height="32" SelectionChanged="OnLoaderChanged">
                <ComboBoxItem Content="不安装" IsSelected="True" />
                <ComboBoxItem Content="Forge" />
                <ComboBoxItem Content="Fabric" />
                <ComboBoxItem Content="NeoForge" />
                <ComboBoxItem Content="Quilt" />
            </ComboBox>
            <ComboBox x:Name="LoaderVersionBox" Width="190" Height="32" Margin="10,0,0,0"
                      IsEnabled="False" />
        </StackPanel>

        <!-- 第三行：光影 + 版本 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="光影" FontSize="12" Width="64" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox x:Name="ShaderBox" Width="140" Height="32" SelectionChanged="OnShaderChanged">
                <ComboBoxItem Content="不安装" IsSelected="True" />
                <ComboBoxItem Content="Iris" />
                <ComboBoxItem Content="OptiFine" />
            </ComboBox>
            <ComboBox x:Name="ShaderVersionBox" Width="190" Height="32" Margin="10,0,0,0"
                      IsEnabled="False" />
        </StackPanel>

        <!-- 第四行：版本名（目录名） -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="版本名" FontSize="12" Width="64" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="VersionNameBox" Width="330" Height="32" />
            <TextBlock Text="（用作目录名）" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <TextBlock Grid.Row="6" x:Name="StatusText" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"
                   VerticalAlignment="Top" Foreground="{DynamicResource TextMutedBrush}" />

        <StackPanel Grid.Row="7" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="InstallButton" Content="开始安装" Style="{StaticResource PrimaryButton}"
                        Click="OnInstall" />
                <Button Content="关闭" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
