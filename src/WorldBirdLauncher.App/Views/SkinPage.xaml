<UserControl x:Class="WorldBirdLauncher.App.Views.SkinPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="皮肤展示" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="AccountText" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="SourceText" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" Text="皮肤来源：解析中…" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgBrush}" CornerRadius="9" Padding="3"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                            ToolTip="切换 3D 预览背景">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DarkBackgroundOption" Content="深夜网格" GroupName="SkinBackground"
                                         Style="{StaticResource SegmentButton}" Checked="OnBackgroundChanged" />
                            <RadioButton x:Name="SkyBackgroundOption" Content="天空草地" GroupName="SkinBackground"
                                         Style="{StaticResource SegmentButton}" Checked="OnBackgroundChanged" />
                        </StackPanel>
                    </Border>
                    <Button Content="刷新皮肤" Style="{StaticResource GhostButton}" Padding="14,5" Margin="10,0,0,0"
                            VerticalAlignment="Center" Click="OnReload" />
                    <Button Content="本地皮肤…" Style="{StaticResource GhostButton}" Padding="14,5" Margin="8,0,0,0"
                            VerticalAlignment="Center" Click="OnPickLocalSkin"
                            ToolTip="离线账户查不到皮肤时，可以挑一张本机的皮肤 PNG" />
                    <Button x:Name="ClearLocalSkinButton" Content="清除本地皮肤" Style="{StaticResource LinkButton}"
                            Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                            Click="OnClearLocalSkin" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
            <Grid>
                <wv2:WebView2 x:Name="SkinView" />
                <!--
                  WPF 层的加载提示：WebView2 还没起来（初始化要 1~2 秒）时先顶在这里，
                  免得那块区域是一片空白。WebView2 一渲染出来就会盖住它（airspace）。
                -->
                <StackPanel x:Name="HintPanel" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Width="120" Height="4" IsIndeterminate="True" />
                    <TextBlock x:Name="HintText" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="正在准备 3D 视图…" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="3D 视图由 skinview3d 渲染（脚本已内置，不依赖 CDN）；皮肤图片按账户类型向官方 / 皮肤站获取。离线账户 ID 不是正版时查不到皮肤，可点「本地皮肤…」挑一张本机 PNG。" />
    </Grid>
</UserControl>
