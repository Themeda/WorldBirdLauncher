<Window x:Class="WorldBirdLauncher.App.Views.JavaDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载适配 Java" Height="360" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="38" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <TextBlock Text="下载适配 Java" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="20,4,20,0">
                <TextBlock x:Name="RequirementText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="DetailText" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ProgressBar x:Name="DownloadProgress" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="100"
                             Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,18">
                <Button x:Name="StartButton" Content="开始下载" Style="{StaticResource PrimaryButton}"
                        Padding="20,6" Margin="0,0,10,0" Click="OnStart" />
                <Button Content="关闭" Style="{StaticResource GhostButton}" Padding="20,6" Click="OnClose" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
