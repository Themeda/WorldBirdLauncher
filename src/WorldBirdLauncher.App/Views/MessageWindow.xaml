<Window x:Class="WorldBirdLauncher.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" SizeToContent="Height" Width="420" MinHeight="150"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="36" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="18,4,18,0">
                <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,16,18,16">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}"
                        Padding="18,6" Margin="0,0,10,0" Click="OnCancel" />
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}"
                        Padding="18,6" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
