<Window x:Class="WorldBirdLauncher.App.Views.IntegrityCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查完整性" Height="560" Width="620" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="38" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <TextBlock Text="检查完整性" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,6,20,0">
                <TextBlock Text="选择版本" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox x:Name="VersionBox" Width="200" Height="30" Margin="10,0,0,0" />
                <Button x:Name="CheckButton" Content="开始检查" Style="{StaticResource PrimaryButton}" Padding="16,5"
                        Margin="12,0,0,0" Click="OnCheck" />
                <Button x:Name="CancelButton" Content="终止校验" Style="{StaticResource GhostButton}" Padding="16,5"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="OnCancel" />
            </StackPanel>

            <ProgressBar x:Name="CheckProgress" Grid.Row="2" Height="5" Margin="20,12,20,0"
                         IsIndeterminate="True" Visibility="Collapsed" />

            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Margin="20,12,20,0"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="12"
                              ScrollChanged="OnLogScrollChanged">
                    <TextBlock x:Name="LogText" FontSize="11" TextWrapping="Wrap" LineHeight="17"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,18">
                <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <Button x:Name="CopyResultButton" Content="复制结果" Style="{StaticResource GhostButton}"
                        Padding="20,6" Margin="0,0,8,0" IsEnabled="False" Click="OnCopyResult" />
                <Button Content="关闭" Style="{StaticResource GhostButton}" Padding="20,6" Click="OnClose" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
